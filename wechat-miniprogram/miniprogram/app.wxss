page{background:#f5f8f7;color:#17201d;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Helvetica Neue',sans-serif}.page{min-height:100vh;padding:28rpx 28rpx 180rpx;box-sizing:border-box}.eyebrow{font-size:22rpx;color:#8b9792;letter-spacing:2rpx}.title{font-size:52rpx;line-height:1.12;font-weight:760;letter-spacing:-2rpx}.subtle{font-size:24rpx;color:#8b9792}.surface{background:#fff;border:1rpx solid #e8eeeb;border-radius:34rpx;box-shadow:0 12rpx 40rpx rgba(30,70,60,.055)}.section{margin-top:36rpx}.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx}.section-title{font-size:30rpx;font-weight:720}.pill{padding:8rpx 16rpx;border-radius:999rpx;background:#edf7f4;color:#227665;font-size:22rpx}.btn-primary{background:#2f8f7a;color:#fff;border-radius:28rpx;font-weight:700;font-size:28rpx;line-height:94rpx;height:94rpx;box-shadow:none}.btn-soft{background:#fff;color:#25302c;border:1rpx solid #e4ebe8;border-radius:28rpx;font-weight:650;font-size:28rpx;line-height:92rpx;height:92rpx;box-shadow:none}.input{height:92rpx;background:#fff;border:1rpx solid #e5ece9;border-radius:24rpx;padding:0 26rpx;font-size:28rpx;box-sizing:border-box}.label{display:block;font-size:23rpx;color:#7f8d87;margin:20rpx 0 10rpx}.empty{padding:50rpx 0;text-align:center;color:#a0aaa6;font-size:25rpx}.divider{height:1rpx;background:#edf1ef}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.danger{color:#ce665d}.safe-area{padding-bottom:env(safe-area-inset-bottom)}
