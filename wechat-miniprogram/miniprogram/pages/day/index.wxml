<view class="page"><view class="eyebrow">DAY REVIEW</view><view class="title">{{label}}</view><view class="subtle">{{date}}</view><view class="day-summary surface"><view><text>{{totals.calories||0}}</text><small>kcal</small></view><view><text>{{totals.protein||0}}g</text><small>蛋白质</small></view><view><text>{{weight||sleep||'--'}}</text><small>{{weight?'体重':sleep?'睡眠':'身体数据'}}</small></view></view><view class="section"><view class="section-head"><view class="section-title">运动</view><text class="pill">{{workouts.length+badminton.length+other.length}} 条</text></view><block wx:if="{{workouts.length||badminton.length||other.length}}"><view wx:for="{{workouts}}" wx:key="id" class="workout surface"><view class="workout-head"><view><text class="workout-name">🏋 {{item.split||item.name||'健身'}}</text><small>{{item.minutes?item.minutes+' 分钟':''}}{{item.calories?' · '+item.calories+' kcal':''}}</small></view><text wx:if="{{item.metricsSource==='apple-watch'}}" class="watch-badge">Watch</text></view><view wx:for="{{item.exercises}}" wx:for-item="ex" wx:key="name" class="exercise"><text>{{ex.name}}</text><small>{{ex.setsText||'已记录'}}</small></view></view><view wx:for="{{badminton}}" wx:key="id" class="simple surface"><view><text>🏸 羽毛球</text><small>{{item.minutes||0}} 分钟 · {{item.calories||0}} kcal</small></view></view><view wx:for="{{other}}" wx:key="id" class="simple surface"><view><text>⌚ {{item.name||'Watch 锻炼'}}</text><small>{{item.minutes||0}} 分钟 · {{item.calories||0}} kcal</small></view></view></block><view wx:else class="empty">这一天没有运动记录</view></view><view class="section"><view class="section-head"><view class="section-title">饮食</view><text class="pill">{{meals.length}} 餐</text></view><view wx:for="{{meals}}" wx:key="id" class="meal surface"><view class="meal-head"><text>{{item.name||'一餐'}}</text><text>{{item.calories||0}} kcal</text></view><view class="meal-macro">P {{item.protein||0}}g · C {{item.carbs||0}}g · F {{item.fat||0}}g</view><view wx:if="{{item.items&&item.items.length}}" class="items"><text wx:for="{{item.items}}" wx:for-item="food" wx:key="index">{{food.name}}{{food.grams?' · '+food.grams+'g':''}}</text></view></view><view wx:if="{{!meals.length}}" class="empty">这一天没有饮食记录</view></view></view>
