.day-summary{display:grid;grid-template-columns:repeat(3,1fr);padding:26rpx;margin-top:28rpx}.day-summary>view{text-align:center}.day-summary>view+view{border-left:1rpx solid #edf1ef}.day-summary text,.day-summary small{display:block}.day-summary text{font-size:31rpx;font-weight:740}.day-summary small{margin-top:5rpx;color:#98a29e;font-size:19rpx}.workout,.meal,.simple{padding:26rpx;margin-bottom:14rpx}.workout-head,.meal-head{display:flex;justify-content:space-between;gap:16rpx}.workout-name,.meal-head text:first-child,.simple text{font-size:28rpx;font-weight:700}.workout-head small,.simple small{display:block;color:#8d9994;font-size:20rpx;margin-top:7rpx}.watch-badge{height:42rpx;line-height:42rpx;padding:0 14rpx;border-radius:999rpx;background:#edf7f4;color:#267866;font-size:19rpx}.exercise{padding-top:18rpx;margin-top:18rpx;border-top:1rpx solid #edf1ef}.exercise text,.exercise small{display:block}.exercise text{font-size:25rpx;font-weight:650}.exercise small{color:#84918c;font-size:19rpx;margin-top:7rpx;line-height:1.6}.meal-macro{color:#7f8c87;font-size:20rpx;margin-top:10rpx}.items{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:14rpx}.items text{padding:7rpx 10rpx;background:#f4f7f6;border-radius:12rpx;color:#7b8882;font-size:18rpx}
