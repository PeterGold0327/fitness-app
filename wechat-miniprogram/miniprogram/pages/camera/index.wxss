.mode{display:flex;background:#e9efec;border-radius:20rpx;padding:6rpx;margin-top:28rpx}.mode view{flex:1;text-align:center;padding:18rpx;color:#7f8c86;font-size:24rpx;border-radius:16rpx}.mode .active{background:#fff;color:#245f52;font-weight:700;box-shadow:0 3rpx 10rpx rgba(31,73,62,.06)}.photo-box{height:410rpx;margin-top:18rpx;border:2rpx dashed #cfdcd7;border-radius:34rpx;background:linear-gradient(145deg,#f2f8f5,#edf5f2);overflow:hidden}.photo-box image{width:100%;height:100%}.photo-empty{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#527068;padding:0 40rpx;text-align:center}.camera-icon{width:92rpx;height:92rpx;border-radius:30rpx;background:#fff;display:grid;place-items:center;font-size:50rpx;margin-bottom:20rpx;box-shadow:0 12rpx 28rpx rgba(58,92,78,.07)}.photo-empty text{font-size:28rpx;font-weight:650}.photo-empty small{font-size:20rpx;color:#8b9a94;margin-top:8rpx;line-height:1.5}.media-actions{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:16rpx}.media-actions button{margin:0;height:106rpx;border:none;border-radius:28rpx;padding:0 22rpx;display:flex;align-items:center;gap:16rpx;text-align:left}.media-actions button:after{border:none}.camera-action{background:#2f8f7a;color:#fff}.album-action{background:#e9f2ef;color:#25483f}.media-icon{width:50rpx;height:50rpx;border-radius:17rpx;background:rgba(255,255,255,.18);display:grid;place-items:center;font-size:29rpx;flex:none}.album-action .media-icon{background:#fff;color:#2f8f7a}.media-actions text{display:block;font-size:25rpx;font-weight:720}.media-actions small{display:block;font-size:18rpx;margin-top:5rpx;opacity:.7}.context{margin-top:16rpx;width:100%}.analyze{margin-top:16rpx}.estimate{margin-top:24rpx;padding:28rpx}.estimate-row{padding:22rpx 0}.estimate-row+.estimate-row{border-top:1rpx solid #edf1ef}.estimate-row .name{font-size:28rpx;font-weight:680;height:48rpx}.numbers{display:flex;gap:12rpx;margin-top:12rpx}.numbers label{height:64