.mode{display:flex;background:#e9efec;border-radius:20rpx;padding:6rpx;margin-top:28rpx}.mode view{flex:1;text-align:center;padding:18rpx;color:#7f8c86;font-size:24rpx;border-radius:16rpx}.mode .active{background:#fff;color:#245f52;font-weight:700;box-shadow:0 3rpx 10rpx rgba(31,73,62,.06)}.photo-box{height:430rpx;margin-top:18rpx;border:2rpx dashed #cfdcd7;border-radius:34rpx;background:#eef6f3;overflow:hidden}.photo-box image{width:100%;height:100%}.photo-empty{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#527068}.camera-icon{width:92rpx;height:92rpx;border-radius:30rpx;background:#fff;display:grid;place-items:center;font-size:50rpx;margin-bottom:20rpx}.photo-empty text{font-size:28rpx;font-weight:650}.photo-empty small{font-size:20rpx;color:#8b9a94;margin-top:8rpx}.context{margin-top:16rpx;width:100%}.analyze{margin-top:16rpx}.estimate{margin-top:24rpx;padding:28rpx}.estimate-row{padding:22rpx 0}.estimate-row+.estimate-row{border-top:1rpx solid #edf1ef}.estimate-row .name{font-size:28rpx;font-weight:680;height:48rpx}.numbers{display:flex;gap:12rpx;margin-top:12rpx}.numbers label{height:64rpx;border-radius:16rpx;background:#f4f7f6;display:flex;align-items:center;padding:0 14rpx}.numbers input{width:90rpx;font-size:24rpx}.numbers label text{font-size:18rpx;color:#8b9792}.remove{margin-left:auto;width:64rpx;height:64rpx;border-radius:18rpx;background:#f7eeee;color:#b96a62;display:grid;place-items:center;font-size:34rpx}.micro{font-size:20rpx;color:#8f9a96;margin-top:10rpx}.total{display:flex;justify-content:space-between;align-items:flex-end;border-top:1rpx solid #e9efec;padding:26rpx 0}.total>view:first-child text{font-size:50rpx;font-weight:780}.total small,.total-macro{font-size:20rpx;color:#8c9893}.manual{margin-top:18rpx;padding:30rpx}.first{margin-top:0}.manual-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 16rpx}.save-manual{margin-top:30rpx}
