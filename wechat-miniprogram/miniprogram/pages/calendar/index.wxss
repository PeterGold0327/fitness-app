.cal-head{display:flex;justify-content:space-between;align-items:flex-start}.cal-nav{display:flex;align-items:center;gap:8rpx;background:#fff;border:1rpx solid #e6ece9;padding:6rpx;border-radius:22rpx}.cal-nav view{min-width:58rpx;height:58rpx;display:grid;place-items:center;border-radius:16rpx;color:#53615b;font-size:34rpx}.cal-nav .today{padding:0 10rpx;font-size:20rpx;color:#267866;background:#eef7f4}.month-title{font-size:34rpx;font-weight:720;margin:38rpx 0 18rpx}.week,.calendar{display:grid;grid-template-columns:repeat(7,1fr)}.week{padding:0 10rpx;margin-bottom:10rpx}.week text{text-align:center;color:#9aa4a0;font-size:20rpx}.calendar{padding:12rpx;gap:4rpx}.cell{min-height:100rpx;border-radius:22rpx;padding:10rpx;box-sizing:border-box}.cell.blank{opacity:0}.cell.has-data{background:#f6f9f8}.cell.today-cell{background:#eaf6f2}.day-num{width:42rpx;height:42rpx;display:grid;place-items:center;font-size:24rpx;border-radius:14rpx}.today-cell .day-num{background:#2f8f7a;color:#fff;font-weight:700}.signals{display:flex;gap:6rpx;flex-wrap:wrap;margin:12rpx 0 0 7rpx}.dot{display:inline-block;width:10rpx;height:10rpx;border-radius:50%;background:#7d8a85}.dot.gym{background:#2f8f7a}.dot.bad{background:#e0a955}.dot.meal{background:#8c9ed5}.dot.watch{background:#90a7a0}.legend{display:flex;gap:22rpx;flex-wrap:wrap;margin-top:20rpx;color:#84918c;font-size:20rpx}.legend text{display:flex;align-items:center;gap:8rpx}.hint{margin-top:28rpx;padding:24rpx 26rpx;border-radius:24rpx;background:#edf6f2;color:#547068;font-size:23rpx}
