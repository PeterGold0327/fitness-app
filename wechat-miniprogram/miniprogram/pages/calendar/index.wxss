.cal-head{display:flex;justify-content:space-between;align-items:flex-start}
.cal-nav{display:flex;align-items:center;gap:8rpx;background:#fff;border:1rpx solid #e6ece9;padding:6rpx;border-radius:22rpx}
.cal-nav view{min-width:58rpx;height:58rpx;display:grid;place-items:center;border-radius:16rpx;color:#53615b;font-size:34rpx}
.cal-nav .today{padding:0 10rpx;font-size:20rpx;color:#267866;background:#eef7f4}
.month-title{font-size:34rpx;font-weight:720;margin:38rpx 0 18rpx}
.week,.calendar{display:grid;grid-template-columns:repeat(7,minmax(0,1fr))}
.week{padding:0 10rpx;margin-bottom:10rpx}
.week text{text-align:center;color:#9aa4a0;font-size:20rpx}
.calendar{padding:12rpx;gap:4rpx}
.cell{min-height:108rpx;min-width:0;border-radius:22rpx;padding:8rpx 6rpx 8rpx;box-sizing:border-box}
.cell.blank{opacity:0}
.cell.has-data{background:#f6f9f8}
.cell.today-cell{background:#eaf6f2}
.day-row{display:flex;align-items:center;justify-content:space-between;gap:2rpx;min-height:42rpx}
.day-num{width:42rpx;height:42rpx;display:grid;place-items:center;font-size:24rpx;border-radius:14rpx;flex:none}
.today-cell .day-num{background:#2f8f7a;color:#fff;font-weight:700}
.shuttle{width:30rpx;height:30rpx;flex:none}
.signals{display:flex;align-items:center;flex-wrap:wrap;gap:4rpx;margin:6rpx 0 0 2rpx;min-height:18rpx;max-width:100%}
.gym-label{max-width:100%;color:#1f7a69;font-size:22rpx;font-weight:720;line-height:1.15;word-break:break-all}
.gym-label.long{font-size:18rpx;letter-spacing:-1rpx;line-height:1.1}
.dot{display:inline-block;width:10rpx;height:10rpx;border-radius:50%;background:#7d8a85;flex:none}
.dot.meal{background:#8c9ed5}
.dot.watch{background:#90a7a0}
.legend{display:flex;gap:22rpx;flex-wrap:wrap;margin-top:20rpx;color:#84918c;font-size:20rpx}
.legend-item{display:flex;align-items:center;gap:8rpx;color:#84918c}
.legend-part{color:#1f7a69;font-weight:720;font-size:22rpx}
.legend-shuttle{width:22rpx;height:22rpx}
.hint{margin-top:28rpx;padding:24rpx 26rpx;border-radius:24rpx;background:#edf6f2;color:#547068;font-size:23rpx}
