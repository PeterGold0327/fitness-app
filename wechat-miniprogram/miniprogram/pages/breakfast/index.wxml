<view class="page breakfast-page">
  <view class="eyebrow">BREAKFAST TEMPLATE</view>
  <view class="title">默认早餐</view>
  <view class="subtle intro">每天早上常吃的东西放在这里。首页一键记录时直接使用这份模板。</view>

  <view class="preview-card">
    <view class="sun">☀️</view>
    <view class="preview-copy">
      <text class="preview-label">{{form.label||'我的默认早餐'}}</text>
      <text class="preview-name">{{form.name}}</text>
      <text class="preview-macro">{{form.calories}} kcal · P {{form.protein}}g · C {{form.carbs}}g · F {{form.fat}}g</text>
    </view>
  </view>

  <view class="form-card surface">
    <text class="field-label">显示名称</text>
    <input class="input" value="{{form.label}}" data-key="label" bindinput="input" placeholder="我的默认早餐"/>

    <text class="field-label">早餐内容</text>
    <textarea class="input meal-input" value="{{form.name}}" data-key="name" bindinput="input" auto-height placeholder="例如：250g酸奶 + 香蕉 + 蓝莓"/>

    <view class="macro-grid">
      <view><text class="field-label">热量</text><view class="number-wrap"><input class="input" type="digit" value="{{form.calories}}" data-key="calories" bindinput="input"/><text>kcal</text></view></view>
      <view><text class="field-label">蛋白质</text><view class="number-wrap"><input class="input" type="digit" value="{{form.protein}}" data-key="protein" bindinput="input"/><text>g</text></view></view>
      <view><text class="field-label">碳水</text><view class="number-wrap"><input class="input" type="digit" value="{{form.carbs}}" data-key="carbs" bindinput="input"/><text>g</text></view></view>
      <view><text class="field-label">脂肪</text><view class="number-wrap"><input class="input" type="digit" value="{{form.fat}}" data-key="fat" bindinput="input"/><text>g</text></view></view>
    </view>
  </view>

  <view class="actions">
    <button class="reset" bindtap="reset">恢复今天这份早餐</button>
    <button class="save" loading="{{saving}}" bindtap="save">保存默认早餐</button>
  </view>
</view>
