.breakfast-page{padding-bottom:60rpx}.intro{margin-top:10rpx;line-height:1.55}.preview-card{margin-top:28rpx;padding:30rpx;background:linear-gradient(135deg,#fffdf7 0%,#f4fbf7 100%);border:1rpx solid #ebe9df;border-radius:34rpx;display:flex;gap:20rpx;align-items:flex-start;box-shadow:0 16rpx 40rpx rgba(69,98,84,.06)}.sun{width:74rpx;height:74rpx;border-radius:24rpx;background:#fff2cf;display:grid;place-items:center;font-size:36rpx;flex:none}.preview-copy{min-width:0}.preview-label,.preview-name,.preview-macro{display:block}.preview-label{font-size:29rpx;font-weight:760;color:#26362f}.preview-name{font-size:21rpx;color:#78857f;line-height:1.5;margin-top:8rpx}.preview-macro{font-size:20rpx;color:#3d8d79;font-weight:650;margin-top:9rpx}.form-card{margin-top:20rpx;padding:28rpx}.field-label{display:block;font-size:21rpx;color:#7c8883;margin:22rpx 0 10rpx}.field-label:first-child{margin-top:0}.meal-input{min-height:100rpx;line-height:1.55;padding-top:20rpx;padding-bottom:20rpx}.macro-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx 18rpx;margin-top:6rpx}.number-wrap{position:relative}.number-wrap .input{padding-right:58rpx}.number-wrap>text{position:absolute;right:18rpx;top:50%;transform:translateY(-50%);font-size:19rpx;color:#9aa5a0}.actions{display:grid;grid-template-columns:.85fr 1.15fr;gap:14rpx;margin-top:22rpx}.actions button{margin:0;border:none;border-radius:28rpx;height:94rpx;line-height:94rpx;font-size:25rpx;font-weight:720}.actions button:after{border:none}.reset{background:#eef4f1;color:#557068}.save{background:#2f8f7a;color:#fff}@media(max-width:360px){.macro-grid,.actions{grid-template-columns:1fr}}
