.login-page{min-height:100vh;padding:110rpx 42rpx 60rpx;box-sizing:border-box;background:linear-gradient(180deg,#f0faf6 0,#f7f9f8 48%,#f5f8f7 100%)}.brand{display:flex;gap:24rpx;align-items:flex-start}.brand-mark{width:74rpx;height:74rpx;border-radius:24rpx;background:#2f8f7a;color:#fff;display:grid;place-items:center;font-size:38rpx;font-weight:800}.title{margin-top:12rpx;font-size:58rpx}.login-card{margin-top:72rpx;padding:36rpx}.login-title{font-size:34rpx;font-weight:750;margin-bottom:8rpx}.login-btn{margin-top:34rpx}.error{margin-top:18rpx;color:#c95f57;font-size:24rpx}.login-note{text-align:center;margin-top:34rpx;color:#9aa5a0;font-size:22rpx;line-height:1.6}
