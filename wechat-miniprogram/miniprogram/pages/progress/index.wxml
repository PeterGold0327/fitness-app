<view class="page"><view class="eyebrow">PROGRESS</view><view class="title">进展</view><view class="hero surface"><view><small>当前体重</small><text>{{current}}</text><small class="change">近两周 {{change}}</small></view><view class="spark"><view wx:for="{{weights}}" wx:key="date" class="spark-row"><text>{{item.date}}</text><view class="spark-line"><i style="width:{{(item.kg/80)*100}}%"></i></view><text>{{item.kg}}</text></view></view></view><view class="stats"><view class="surface"><text>{{weekGym}}</text><small>近 7 天健身</small></view><view class="surface"><text>{{avgProtein}}g</text><small>近 7 天平均蛋白</small></view></view><view class="section"><view class="section-title">最近训练</view><view class="recent surface"><view wx:for="{{recent}}" wx:key="id" class="recent-row"><view><text>{{item.split||item.name||'健身'}}</text><small>{{item.date}}</small></view><text>{{item.minutes||0}} min</text></view><view wx:if="{{!recent.length}}" class="empty">开始记录后，这里会慢慢变成你的进步轨迹。</view></view></view></view>
