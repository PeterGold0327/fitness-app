.hero{margin-top:28rpx;padding:32rpx}.hero>view:first-child small,.hero>view:first-child text{display:block}.hero>view:first-child>small{color:#8d9994;font-size:22rpx}.hero>view:first-child>text{font-size:68rpx;font-weight:780;margin-top:6rpx}.hero .change{color:#2f8f7a!important;margin-top:6rpx}.spark{margin-top:28rpx;padding-top:20rpx;border-top:1rpx solid #edf1ef}.spark-row{display:grid;grid-template-columns:70rpx 1fr 70rpx;gap:12rpx;align-items:center;margin-top:10rpx;color:#8a9691;font-size:18rpx}.spark-line{height:8rpx;background:#eff3f1;border-radius:999rpx;overflow:hidden}.spark-line i{display:block;height:100%;background:#74b8a6;border-radius:999rpx}.stats{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:18rpx}.stats>view{padding:28rpx}.stats text,.stats small{display:block}.stats text{font-size:42rpx;font-weight:760}.stats small{color:#8d9994;font-size:20rpx;margin-top:6rpx}.recent{padding:0 26rpx;margin-top:18rpx}.recent-row{display:flex;justify-content:space-between;padding:24rpx 0;align-items:center}.recent-row+.recent-row{border-top:1rpx solid #edf1ef}.recent-row text{font-size:25rpx;font-weight:650}.recent-row small{display:block;color:#98a29e;font-size:19rpx;margin-top:5rpx}.recent-row>text{color:#76837e;font-size:21rpx;font-weight:500}
