.top{display:flex;justify-content:space-between;align-items:flex-start;margin-top:10rpx}.weight-chip{padding:14rpx 18rpx;background:#fff;border:1rpx solid #e5ece9;border-radius:24rpx;text-align:right}.weight-chip text{display:block;font-size:25rpx;font-weight:700}.weight-label{font-size:18rpx!important;color:#9aa5a0!important;font-weight:500!important;margin-top:3rpx}.energy{margin-top:32rpx;padding:36rpx;display:flex;align-items:center;justify-content:space-between;background:linear-gradient(140deg,#ffffff 0%,#f2fbf7 100%)}.energy-number{font-size:94rpx;line-height:1;font-weight:780;letter-spacing:-6rpx;margin-top:14rpx}.energy-unit{margin-top:9rpx;color:#6f7d77;font-size:24rpx}.energy-unit text{color:#a0aaa6}.energy-orb{width:156rpx;height:156rpx;border-radius:50%;background:conic-gradient(#52ad96 0 65%,#e7f1ed 65%);display:grid;place-items:center}.orb-inner{width:126rpx;height:126rpx;border-radius:50%;background:#fff;display:grid;place-items:center;color:#2f8f7a;font-weight:750;font-size:28rpx}.macro{margin-top:18rpx;padding:28rpx 30rpx}.macro-item+.macro-item{margin-top:24rpx}.macro-item .row{font-size:24rpx}.macro-item .row text:last-child{color:#78857f}.track{height:10rpx;background:#edf2ef;border-radius:999rpx;overflow:hidden;margin-top:12rpx}.fill{height:100%;border-radius:999rpx;background:#5cb49d}.carbs{background:#8ba8dc}.fat{background:#e3b76b}.breakfast-card{margin-top:20rpx;padding:28rpx 26rpx;background:linear-gradient(135deg,#fffdf7 0%,#f8fbf4 100%);border:1rpx solid #ece8dc;border-radius:34rpx;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:18rpx;box-shadow:0 12rpx 32rpx rgba(78,103,91,.055)}.breakfast-card.done{background:#f7faf8;border-color:#e4ece8}.breakfast-icon{width:68rpx;height:68rpx;border-radius:22rpx;background:#fff3d8;display:grid;place-items:center;font-size:34rpx}.breakfast-copy{min-width:0}.breakfast-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12rpx}.breakfast-kicker{font-size:17rpx;letter-spacing:2rpx;color:#a99a75;font-weight:700}.breakfast-title{font-size:28rpx;font-weight:760;color:#24332e;margin-top:4rpx}.breakfast-edit{font-size:19rpx;color:#6f8f85;padding:7rpx 10rpx;border-radius:999rpx;background:rgba(255,255,255,.7);flex:none}.breakfast-food{font-size:20rpx;color:#7f8b86;margin-top:8rpx;line-height:1.45}.breakfast-macro{font-size:19rpx;color:#4b8f7d;margin-top:6rpx;font-weight:650}.breakfast-action{margin:0;padding:0 20rpx;min-width:116rpx;height:64rpx;line-height:64rpx;border:none;border-radius:999rpx;background:#e5f2ed;color:#2f8f7a;font-size:21rpx;font-weight:700}.breakfast-action:after{border:none}.breakfast-action[disabled]{background:#eef2f0;color:#9aa5a0}.quick{display:grid;grid-template-columns:1.25fr 1fr;gap:16rpx;margin-top:20rpx}.quick button{margin:0;height:auto;min-height:124rpx;border-radius:30rpx;padding:22rpx;border:none;display:flex;align-items:center;gap:18rpx;text-align:left;line-height:1.2}.quick button:after{border:none}.quick-main{background:#2f8f7a;color:#fff}.quick-side{background:#eaf3f0;color:#1d3932}.quick-icon{width:56rpx;height:56rpx;border-radius:18rpx;background:rgba(255,255,255,.18);display:grid;place-items:center;font-size:38rpx}.quick-icon.soft{background:#fff;color:#2f8f7a}.quick text{display:block;font-size:27rpx;font-weight:720}.quick small{display:block;margin-top:8rpx;font-size:19rpx;opacity:.72}.list{padding:0 26rpx}.list-item{display:flex;align-items:center;gap:18rpx;padding:24rpx 0}.list-item+.list-item{border-top:1rpx solid #edf1ef}.meal-dot{width:16rpx;height:16rpx;border-radius:50%;background:#65b39f}.activity-icon{font-size:34rpx}.list-main{flex:1;min-width:0}.list-main text{display:block;font-size:27rpx;font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.list-main small{display:block;margin-top:7rpx;font-size:20rpx;color:#909b97}.list-value{font-size:23rpx;color:#64716c}@media(max-width:360px){.breakfast-card{grid-template-columns:auto 1fr}.breakfast-action{grid-c