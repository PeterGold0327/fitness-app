<view class="page">
  <view class="top">
    <view>
      <view class="eyebrow">TODAY</view>
      <view class="title">今天</view>
      <view class="subtle">{{date}}</view>
    </view>
    <view class="weight-chip"><text>{{weight}}</text><text class="weight-label">体重</text></view>
  </view>

  <view class="energy surface">
    <view class="energy-copy">
      <view class="eyebrow">还可以吃</view>
      <view class="energy-number">{{remain}}</view>
      <view class="energy-unit">kcal <text>· 已吃 {{calories}} / {{goal}}</text></view>
    </view>
    <view class="energy-orb"><view class="orb-inner">{{calories}}</view></view>
  </view>

  <view class="macro surface">
    <view class="macro-item">
      <view class="row"><text>蛋白质</text><text>{{protein}} / {{proteinGoal}}g</text></view>
      <view class="track"><view class="fill protein" style="width:{{proteinPct}}%"></view></view>
    </view>
    <view class="macro-item">
      <view class="row"><text>碳水</text><text>{{carbs}} / {{carbGoal}}g</text></view>
      <view class="track"><view class="fill carbs" style="width:{{carbPct}}%"></view></view>
    </view>
    <view class="macro-item">
      <view class="row"><text>脂肪</text><text>{{fat}} / {{fatGoal}}g</text></view>
      <view class="track"><view class="fill fat" style="width:{{fatPct}}%"></view></view>
    </view>
  </view>

  <view class="breakfast-card {{breakfastLogged?'done':''}}">
    <view class="breakfast-icon">☀️</view>
    <view class="breakfast-copy">
      <view class="breakfast-head"><view><view class="breakfast-kicker">MY BREAKFAST</view><view class="breakfast-title">{{breakfast.label||'我的默认早餐'}}</view></view><text class="breakfast-edit" bindtap="editBreakfast">编辑</text></view>
      <view class="breakfast-food">{{breakfast.name}}</view>
      <view class="breakfast-macro">{{breakfast.calories}} kcal · P{{breakfast.protein}} · C{{breakfast.carbs}} · F{{breakfast.fat}}</view>
    </view>
    <button class="breakfast-action" disabled="{{breakfastLogged||breakfastSaving}}" bindtap="addBreakfast">{{breakfastLogged?'已记录':breakfastSaving?'记录中':'一键记录'}}</button>
  </view>

  <view class="quick">
    <button class="quick-main" bindtap="photo">
      <view class="quick-icon">＋</view>
      <view><text>记录一餐</text><small>拍照、相册或手动输入</small></view>
    </button>
    <button class="quick-side" bindtap="workout">
      <view class="quick-icon soft">↗</view>
      <view><text>开始训练</text><small>重量 · 次数 · RPE</small></view>
    </button>
  </view>

  <view class="section">
    <view class="section-head"><view class="section-title">今天吃了什么</view><text class="pill">{{meals.length}} 餐</text></view>
    <view class="surface list">
      <block wx:if="{{meals.length}}">
        <view wx:for="{{meals}}" wx:key="id" class="list-item">
          <view class="meal-dot"></view>
          <view class="list-main"><text>{{item.name||'一餐'}}</text><small>P {{item.protein||0}} · C {{item.carbs||0}} · F {{item.fat||0}}</small></view>
          <text class="list-value">{{item.calories||0}} kcal</text>
        </view>
      </block>
      <view wx:else class="empty">今天还没有饮食记录</view>
    </view>
  </view>

  <view class="section">
    <view class="section-head"><view class="section-title">今天的运动</view><text class="pill" bindtap="calendar">看日历</text></view>
    <view class="surface list">
      <block wx:if="{{activities.length}}">
        <view wx:for="{{activities}}" wx:key="index" class="list-item">
          <view class="activity-icon">{{item.icon}}</view>
          <view class="list-main"><text>{{item.name}}</text><small>{{item.meta||'已记录'}}</small></view>
        </view>
      </block>
      <view wx:else class="empty">今天还没有运动记录</view>
    </view>
  </view>
</view>
