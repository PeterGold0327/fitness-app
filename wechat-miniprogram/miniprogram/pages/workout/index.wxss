.split-row{display:flex;gap:10rpx;margin-top:28rpx}.split{flex:1;text-align:center;padding:18rpx 0;border-radius:18rpx;background:#e9efec;color:#7d8a85;font-size:24rpx}.split.active{background:#2f8f7a;color:#fff;font-weight:700}.watch-note{margin-top:16rpx;padding:20rpx 24rpx;border-radius:22rpx;background:#eaf6f2;color:#32685b;font-size:22rpx}.watch-note.soft{background:#f0f3f2;color:#82908a}.exercise-card{margin-top:18rpx;padding:26rpx}.exercise-name{font-size:31rpx;font-weight:740;height:56rpx}.previous{font-size:19rpx;color:#94a09b;margin-top:5rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.set-head,.set-row{display:grid;grid-template-columns:46rpx 1fr 1fr 1fr 54rpx;gap:8rpx;align-items:center}.set-head{margin-top:22rpx;color:#98a29e;font-size:18rpx;text-align:center}.set-row{margin-top:9rpx}.set-row>text{text-align:center;color:#7d8a85;font-size:21rpx}.set-row input{height:68rpx;border-radius:16rpx;background:#f3f6f5;text-align:center;font-size:23rpx}.remove{height:58rpx;border-radius:16rpx;background:#f8eeee;color:#b96760;display:grid;place-items:center;font-size:30rpx}.add{margin-top:14rpx;padding:16rpx;text-align:center;color:#2f806d;background:#f0f7f5;border-radius:18rpx;font-size:22rpx}.save{margin-top:24rpx}
