.tabbar{position:fixed;z-index:99;left:24rpx;right:24rpx;bottom:18rpx;display:flex;align-items:center;justify-content:space-around;height:112rpx;padding:0 10rpx;background:rgba(255,255,255,.96);border:1rpx solid #e5ece9;border-radius:34rpx;box-shadow:0 18rpx 50rpx rgba(27,65,55,.12)}.tab{flex:1;text-align:center;color:#909b97;font-size:20rpx}.icon{font-size:34rpx;height:42rpx;line-height:42rpx}.active{color:#267866}.capture{position:relative;color:#fff}.capture .icon{width:74rpx;height:74rpx;line-height:68rpx;margin:-34rpx auto 4rpx;border-radius:50%;background:#2f8f7a;font-size:54rpx;font-weight:300;box-shadow:0 12rpx 28rpx rgba(47,143,122,.28)}.capture text{color:#267866}.safe-area{padding-bottom:env(safe-area-inset-bottom)}
